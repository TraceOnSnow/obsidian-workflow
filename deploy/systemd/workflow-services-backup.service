[Unit]
Description=Verified private Payload data and historical workspace backup
Documentation=file:%h/projects/obsidian-workflow/docs/reliability.md

[Service]
Type=oneshot
WorkingDirectory=%h/projects/obsidian-workflow
ExecStart=%h/projects/obsidian-workflow/.venv/bin/python %h/projects/obsidian-workflow/scripts/service-backup.py create --keep 14
UMask=0077
Nice=10
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
